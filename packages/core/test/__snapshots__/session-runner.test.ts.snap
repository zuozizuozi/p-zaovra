exports[`SessionRunnerLLM S1 token budget stops without failure and supports live adjustment 1`] = `
[
  ""本会话已记录 120 Tokens，达到配置预算 100；已停止发起新的模型请求，已完成的操作已保留。需要明确续授：可在会话界面提高或移除预算后直接继续，无需重启；已保留成果和未完成事项，这不是任务完成。\\n现场摘要：{\\"changes\\":[],\\"checks\\":[]}"",
]
`;

exports[`SessionRunnerLLM warns once near the session budget in model history without changing the system prefix 1`] = `
[
  "Session token budget notice (limit=1000): 750 tokens have been reported; 250 remain before the next-request stop. This includes cached input and reasoning. This is a session-wide limit, not a per-message allowance. Focus on the requested deliverable and its remaining checks; avoid optional expansion and repeated environment setup. Do not skip necessary validation, manufacture passing reports, or claim unfinished work is complete. If the remaining budget cannot cover completion, preserve the current work and state the specific remaining steps.",
]
`;

exports[`490 explicit closing reserve cancels only same-source tasks and retains a durable unverified receipt 1`] = `"[host.run.closing] request:request {"requestID":"request","sourceMessageID":"request","deadline":1000,"closingReserveMs":1500,"state":"stopped_unverified","cancelled":["job-0"],"preserved":["job-1","job-2","job-3","job-4"]}"`;

exports[`SessionRunnerLLM reviews green engineering work once and does not repeat after compaction or resume 1`] = `"["Verification closing review: {\\"state\\":\\"completed_unverified\\",\\"facts\\":{\\"changes\\":[],\\"checks\\":[]},\\"missing\\":[\\"acceptance\\",\\"requirements\\"],\\"failed\\":[],\\"coverage\\":[],\\"userRequests\\":[\\"Check empty CSV round trips\\"],\\"requirements\\":[{\\"id\\":1,\\"text\\":\\"Check empty CSV round trips\\",\\"sourceMessageID\\":\\"message\\",\\"sourceStart\\":0,\\"sourceEnd\\":27,\\"version\\":\\"hash-0\\"}]}\\nReview the original visible user requirements and their corrections against the final artifacts, even when all existing tests passed. Identify requirements not covered by the tests, including empty/minimum values, negative/error cases and stated invariants. Inspect the actual assertions, add focused checks for uncovered requirements, and correct concrete defects in this same loop. Use ordinary bash commands with verification_requirements to describe requirements actually asserted; identify verification_assertions and include source and assertion files as verification_targets. Do not output report JSON as a shell command. Preserve failed assertions when repairing implementation. If an assertion is wrong, explain the user requirement supporting the correction and report the original failure as requiring review; changing expectations is not proof of a fix. A self-written green test suite is not independent proof of full acceptance. Preserve valid existing checks, do not run unrelated checks or invent extra deliverables. If evidence remains missing, explicitly report unverified scope and known failures. This automatic closing review occurs at most once for this user request."]"`;

exports[`Q3 Q5 evidence review is bounded without new evidence and names independent checks 1`] = `"{"prompts":["Verification closing review: evidence key hash-0. Missing: [\\"acceptance\\",\\"requirements\\",\\"requirements review: submit verification_review with evidence or an explicit unverified reason for every original requirement\\"]. Compare original requirements with current artifacts and actual assertions, including uncovered negative cases. Reopen only checks affected by changed requirements, dependencies, environment or new failures. All green is not proof of full coverage. Preserve failed assertions and report unresolved scope; do not repeat unchanged passing checks. Identify the original source for each critical assumption. Check the actual end-to-end result against that source. State unverified scope and why; self-written tests or another model's agreement are not independent proof."],"records":[{"key":"hash-0","decision":"review","reason":"candidate-complete","pending":[],"gaps":["hash-1","hash-2","hash-3"],"missing":["acceptance","requirements","requirements review: submit verification_review with evidence or an explicit unverified reason for every original requirement"],"requirements":[{"id":1,"sourceMessageID":"message"}]},{"key":"hash-0","decision":"unverified","reason":"blocked","pending":[],"gaps":["hash-1","hash-2","hash-3","hash-3"],"missing":["acceptance","requirements","requirements review: submit verification_review before claiming completion","requirements review: submit verification_review with evidence or an explicit unverified reason for every original requirement"],"requirements":[{"id":1,"sourceMessageID":"message"}]},{"key":"hash-0","decision":"unverified","reason":"blocked","pending":[],"gaps":["hash-1","hash-2","hash-3","hash-3"],"missing":["acceptance","requirements","requirements review: submit verification_review before claiming completion","requirements review: submit verification_review with evidence or an explicit unverified reason for every original requirement"],"requirements":[{"id":1,"sourceMessageID":"message"}]}]}"`;

exports[`K2 a new failure reminder omits gaps already explained on an earlier close 1`] = `""Verification closing review: evidence key hash-0. Missing: [\\"failed: test (check-1)\\"]. Compare original requirements with current artifacts and actual assertions, including uncovered negative cases. Reopen only checks affected by changed requirements, dependencies, environment or new failures. All green is not proof of full coverage. Preserve failed assertions and report unresolved scope; do not repeat unchanged passing checks.""`;

